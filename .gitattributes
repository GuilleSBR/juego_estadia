# Configuracion de finales de linea

* text=auto

# Escenas y recursos de Godot: texto con finales LF

*.tscn text eol=lf
*.tres text eol=lf
*.gd text eol=lf
*.godot text eol=lf
*.uid text eol=lf
*.cfg text eol=lf
*.gdshader text eol=lf
*.shader text eol=lf

# Archivos de importacion y recursos binarios de Godot

*.import text eol=lf
*.scn binary
*.res binary

# Imagenes

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.svg binary

# Audio

*.ogg binary
*.wav binary
*.mp3 binary

# Fuentes

*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# Modelos 3D

*.glb binary
*.gltf binary
*.blend binary
*.fbx binary
*.obj binary

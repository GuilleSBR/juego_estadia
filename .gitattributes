# Set default behavior to handle text files with auto LF normalization
* text=auto

# Archivos de texto de Godot (normalizar saltos de línea a LF)
*.tscn text eol=lf
*.tres text eol=lf
*.gd text eol=lf
*.godot text eol=lf
*.uid text eol=lf
*.cfg text eol=lf

# Archivos de importación y binarios de Godot
*.import binary
*.scn binary
*.res binary

# Archivos multimedia, fuentes y 3D
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.svg binary
*.ogg binary
*.wav binary
*.mp3 binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.glb binary
*.gltf binary
*.blend binary
*.fbx binary
*.obj binary
